@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<p>
    This page is restricted to authenticated users
    assigned to the admin role.
</p>

<p>
    <strong>Authenticated user:</strong><br />
    @User.Identity?.Name
</p>

<p>
    <strong>Admin role verified:</strong><br />
    @User.IsInRole("admin")
</p>

<p>
    <a asp-controller="Home" asp-action="Index">
        Return to SafeVault
    </a>
</p>